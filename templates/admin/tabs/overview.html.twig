<section class="admin-panel">
  <h2>Metrics Dashboard</h2>
  <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px;">
    Overview of key system metrics and statistics.
  </p>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
    <div class="order-detail-panel">
      <h3>Total Users</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: #0adde0; margin-top: 10px;">{{ data.total_users|number_format }}</p>
    </div>
    <div class="order-detail-panel">
      <h3>Total Products</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: #4ade80; margin-top: 10px;">{{ data.total_products|number_format }}</p>
    </div>
    <div class="order-detail-panel">
      <h3>Total Orders</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: #4f8ff7; margin-top: 10px;">{{ data.total_orders|number_format }}</p>
    </div>
    <div class="order-detail-panel">
      <h3>Total Revenue</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: #facc15; margin-top: 10px;">₱{{ data.total_revenue|number_format(2) }}</p>
    </div>
    <div class="order-detail-panel">
      <h3>Placeholder Metrics</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: var(--text-faint, #7a8ba3); margin-top: 10px;">—</p>
    </div>
    <div class="order-detail-panel">
      <h3>Placeholder Metrics</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: var(--text-faint, #7a8ba3); margin-top: 10px;">—</p>
    </div>
    <div class="order-detail-panel">
      <h3>Shop Revenue</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: #4f8ff7; margin-top: 10px;">₱{{ data.shop_revenue|number_format(2) }}</p>
    </div>
    <div class="order-detail-panel">
      <h3>Potential Revenue</h3>
      <p style="font-size: 1.8rem; font-weight: bold; color: #facc15; margin-top: 10px;">₱{{ data.potential_revenue|number_format(2) }}</p>
    </div>
  </div>
</section>
